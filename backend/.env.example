PORT=4000
# MongoDB Atlas connection string
MONGODB_URI=
# Any long random string (signs login tokens)
JWT_SECRET=
# Python ML service (uvicorn api:app --port 8000)
ML_URL=http://127.0.0.1:8000

# Chain: local Hardhat node by default. For Amoy: RPC_URL=https://rpc-amoy.polygon.technology
RPC_URL=http://127.0.0.1:8545
# Deployment file written by contracts/scripts/deploy.js (localhost.json or amoy.json)
DEPLOYMENT_FILE=../contracts/deployments/localhost.json
# Oracle wallet = the deployer (has ORACLE_ROLE). THROWAWAY KEY ONLY.
# For local Hardhat use the first key printed by `npx hardhat node`.
ORACLE_PRIVATE_KEY=

# Pinata IPFS (from app.pinata.cloud -> API keys). If none are set, audit files are stored
# locally and every CID is labelled "simulation".
PINATA_JWT=
# ...or the older API key + secret pair (either option works)
PINATA_API_KEY=
PINATA_API_SECRET=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Comma-separated wallet addresses allowed to act as verifiers (manual review queue)
VERIFIER_ADDRESSES=
